# API Keys
OPENAI_API_KEY=your-openai-key-here
DUNE_API_KEY=your-dune-key-here
COINGECKO_API_KEY=your-coingecko-key-here

# Database
DATABASE_URL=sqlite:///./trading.db

# Risk Settings
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_HEAT_PCT=6.0

# Alert Thresholds
EXCHANGE_INFLOW_THRESHOLD_MULTIPLIER=3.0
TVL_DROP_THRESHOLD_PCT=20.0
SMART_MONEY_FLOW_THRESHOLD=100000

# Polling (seconds)
NEWS_POLL_INTERVAL=300
ONCHAIN_POLL_INTERVAL=60
